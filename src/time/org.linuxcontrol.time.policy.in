<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Linux Control Panel</vendor>
  <action id="org.linuxcontrol.time.configure">
    <description>Configure Internet time synchronization</description>
    <message>Authentication is required to change Internet time settings.</message>
    <icon_name>preferences-system-time</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CONTROL_TIME_HELPER_PATH@</annotate>
  </action>
</policyconfig>
